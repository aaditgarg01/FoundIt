{
  "name": "foundit",
  "version": "1.0.0",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "seed:reference": "node db/scripts/seed_reference.js",
    "seed:data": "node db/scripts/seed_data.js",
    "start": "node src/server.js",
    "dev": "concurrently -k \"node --watch src/server.js\" \"vite --config client/vite.config.mjs\"",
    "build": "vite build --config client/vite.config.mjs",
    "test": "node scripts/test.js",
    "seed:demo": "node scripts/seed-demo.js",
    "expire": "node scripts/expire.js",
    "test:mutation": "node scripts/verify-mutation.js",
    "evaluate": "node scripts/evaluate-matching.js",
    "benchmark": "node scripts/benchmark.js",
    "format": "prettier --write client/src src db/queries scripts tests",
    "build:vercel": "node scripts/prepare-deployment.js && npm run build"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.59.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vite": "^6.4.4"
  },
  "jest": {
    "testMatch": [
      "**/tests/*.test.js"
    ],
    "testTimeout": 30000
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "^11.1.0"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
