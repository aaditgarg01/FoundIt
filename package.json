{
  "name": "foundit",
  "version": "1.0.0",
  "scripts": {
    "migrate": "dotenv run -f .env -- node-pg-migrate -m db/migrations up",
    "migrate:down": "dotenv run -f .env -- node-pg-migrate -m db/migrations down 1",
    "migrate:reset": "dotenv run -f .env -- node-pg-migrate -m db/migrations down 100",
    "seed:reference": "node db/scripts/seed_reference.js",
    "seed:data": "node db/scripts/seed_data.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.11.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
